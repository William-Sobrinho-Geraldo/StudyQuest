# ===========================================================================
# Modelo das variáveis de ambiente. Copie conforme o uso:
#
#   Desenvolvimento/testes  -> .env            (chaves de teste do AdMob)
#   Build final (release)   -> .env.production (chaves reais do AdMob)
#
# IMPORTANTE (Compartilhado em ambos os arquivos)
#   - VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: o Supabase usa as MESMAS
#     chaves nos dois ambientes, então basta mantê-las no .env.
#
# IMPORTANTE (AdMob)
#   - O App ID do AdMob PRECISA estar no AndroidManifest.xml (o SDK Google
#     exige; não é possível injetá-lo via JS). Os scripts abaixo trocam o
#     valor no manifest automaticamente durante o build:
#       npm run build:mobile       -> App ID real      (le .env.production)
#       npm run build:mobile:dev   -> App ID de teste  (le .env)
# ===========================================================================

# --- Supabase (mesmas chaves em .env e .env.production) ---
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_PUBLISHABLE_KEY"

# --- AdMob: App ID (meta-data APPLICATION_ID no AndroidManifest) ---
#   .env (dev)            -> chave de teste: ca-app-pub-3940256099942544~3347511713
#   .env.production       -> chave real da sua conta
VITE_ADMOB_APP_ID="ca-app-pub-XXXXXXXXXXXXXXXX/~XXXXXXXXXX"

# --- AdMob: Rewarded Video ad unit ID ---
#   .env (dev)            -> unidade de teste: ca-app-pub-3940256099942544/5224354917
#   .env.production       -> unidade real da sua conta
VITE_ADMOB_REWARDED_ID="ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX"
